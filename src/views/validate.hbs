<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to ShopHub - OTP Verification</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; } body { font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, #111827 0%, #1f2937 100%); min-height:
      100vh; display: flex; align-items: center; justify-content: center;
      padding: 4rem 1rem; color: #ffffff; } .container { max-width: 42rem;
      width: 100%; } .main-card { background: #111827; border-radius: 1rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8); overflow: hidden;
      border: 1px solid #374151; } .header { position: relative; background:
      linear-gradient(135deg, #3b82f6 0%, #1d4ed8 50%, #1e40af 100%); padding:
      3rem 2rem; text-align: center; color: white; overflow: hidden; }
      .header::before { content: ''; position: absolute; top: -4rem; right:
      -4rem; width: 8rem; height: 8rem; background: rgba(255, 255, 255, 0.1);
      border-radius: 50%; } .header::after { content: ''; position: absolute;
      bottom: -5rem; left: -5rem; width: 10rem; height: 10rem; background:
      rgba(255, 255, 255, 0.05); border-radius: 50%; } .decorative-circle {
      position: absolute; top: 33%; right: 25%; width: 3rem; height: 3rem;
      background: rgba(255, 255, 255, 0.2); border-radius: 50%; } .logo {
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.5rem; position: relative; z-index: 10; } .logo-icon {
      padding: 0.75rem; background: rgba(255, 255, 255, 0.2); border-radius:
      50%; backdrop-filter: blur(4px); margin-right: 0.75rem; } .logo-text {
      font-size: 1.875rem; font-weight: 700; } .welcome-title { font-size:
      1.875rem; font-weight: 700; margin-bottom: 0.75rem; position: relative;
      z-index: 10; } .welcome-subtitle { font-size: 1.125rem; opacity: 0.9;
      line-height: 1.625; position: relative; z-index: 10; } .content { padding:
      2.5rem 2rem; } .verification-section { text-align: center; margin-bottom:
      2rem; } .mail-icon-container { display: inline-flex; align-items: center;
      justify-content: center; width: 4rem; height: 4rem; background: #1e3a8a;
      border-radius: 50%; margin-bottom: 1.5rem; } .section-title { font-size:
      1.5rem; font-weight: 700; color: #ffffff; margin-bottom: 0.75rem; }
      .section-subtitle { color: #9ca3af; font-size: 1.125rem; margin-bottom:
      2rem; } .otp-container { background: linear-gradient(135deg, rgba(30, 58,
      138, 0.2) 0%, rgba(30, 64, 175, 0.2) 100%); border-radius: 1rem; padding:
      1.5rem; margin-bottom: 1.5rem; border: 1px solid #1e40af; } .otp-display {
      display: flex; align-items: center; justify-content: center; gap: 1rem; }
      .otp-code { font-size: 2.25rem; font-weight: 700; color: #93c5fd;
      letter-spacing: 0.1em; font-family: 'Courier New', monospace; }
      .copy-button { display: flex; align-items: center; gap: 0.5rem; padding:
      0.5rem 1rem; background: #3b82f6; color: white; border: none;
      border-radius: 0.5rem; font-weight: 500; font-size: 0.875rem; cursor:
      pointer; transition: background-color 0.2s; } .copy-button:hover {
      background: #2563eb; } .copy-button.copied { background: #10b981; }
      .instructions-box { background: #1f2937; border-radius: 0.75rem; padding:
      1.5rem; margin-bottom: 1.5rem; border: 1px solid #374151; }
      .instructions-text { color: #d1d5db; line-height: 1.625; } .expiry-warning
      { display: flex; align-items: center; justify-content: center; gap:
      0.5rem; color: #fbbf24; background: rgba(146, 64, 14, 0.2); border-radius:
      0.5rem; padding: 0.75rem 1rem; border: 1px solid #92400e; margin-bottom:
      2rem; } .expiry-text { font-weight: 500; font-size: 0.875rem; }
      .security-box { background: rgba(30, 58, 138, 0.2); border-radius:
      0.75rem; padding: 1.5rem; border: 1px solid #1e40af; } .security-content {
      display: flex; align-items: flex-start; gap: 0.75rem; } .security-icon {
      color: #60a5fa; flex-shrink: 0; margin-top: 0.125rem; } .security-title {
      font-weight: 600; color: #dbeafe; margin-bottom: 0.5rem; } .security-text
      { color: #bfdbfe; font-size: 0.875rem; line-height: 1.625; } .footer {
      background: #1f2937; padding: 1.5rem 2rem; border-top: 1px solid #374151;
      text-align: center; } .footer-text { color: #9ca3af; margin-bottom:
      0.75rem; } .support-button { display: inline-flex; align-items: center;
      padding: 0.5rem 1.5rem; background: #3b82f6; color: white;
      text-decoration: none; border-radius: 0.5rem; font-weight: 500;
      transition: background-color 0.2s; border: none; cursor: pointer; }
      .support-button:hover { background: #2563eb; } .additional-help {
      margin-top: 1.5rem; text-align: center; } .help-text { color: #9ca3af;
      font-size: 0.875rem; } .resend-button { margin-left: 0.5rem; color:
      #60a5fa; font-weight: 500; text-decoration: underline; background: none;
      border: none; cursor: pointer; transition: color 0.2s; }
      .resend-button:hover { color: #93c5fd; text-decoration: none; } @media
      (max-width: 640px) { body { padding: 2rem 1rem; } .header { padding: 2rem
      1rem; } .content { padding: 2rem 1rem; } .footer { padding: 1.5rem 1rem; }
      .welcome-title { font-size: 1.5rem; } .welcome-subtitle { font-size: 1rem;
      } .otp-code { font-size: 1.75rem; } .otp-display { flex-direction: column;
      gap: 0.75rem; } }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="main-card">
        <!-- Header with Gradient -->
        <div class="header">
          <div class="decorative-circle"></div>

          <div class="logo">
            <div class="logo-icon">
              <i class="fas fa-shopping-bag" style="font-size: 2.5rem;"></i>
            </div>
            <span class="logo-text">ShopHub</span>
          </div>

          <h1 class="welcome-title">
            Welcome to ShopHub, John Doe!
          </h1>
          <p class="welcome-subtitle">
            We're excited to have you on board! Get ready to explore all the
            amazing features ShopHub has to offer.
          </p>
        </div>

        <!-- Content -->
        <div class="content">
          <div class="verification-section">
            <div class="mail-icon-container">
              <i
                class="fas fa-envelope"
                style="font-size: 2rem; color: #60a5fa;"
              ></i>
            </div>

            <h2 class="section-title">Account Verification</h2>
            <p class="section-subtitle">
              Your OTP for account verification is:
            </p>

            <!-- OTP Display -->
            <div class="otp-container">
              <div class="otp-display">
                <div class="otp-code" id="otpCode">847392</div>
                <button class="copy-button" id="copyButton" onclick="copyOTP()">
                  <i class="fas fa-copy" id="copyIcon"></i>
                  <span id="copyText">Copy</span>
                </button>
              </div>
            </div>

            <!-- Instructions -->
            <div class="instructions-box">
              <p class="instructions-text">
                Please enter this code in the verification section to complete
                your signup process.
              </p>
            </div>

            <!-- Expiry Warning -->
            <div class="expiry-warning">
              <i class="fas fa-clock"></i>
              <span class="expiry-text">OTP expires in 5 minutes</span>
            </div>
          </div>

          <!-- Security Note -->
          <div class="security-box">
            <div class="security-content">
              <i
                class="fas fa-shield-alt security-icon"
                style="font-size: 1.5rem;"
              ></i>
              <div>
                <h3 class="security-title">Security Reminder</h3>
                <p class="security-text">
                  Never share your OTP with anyone. ShopHub will never ask for
                  your verification code via phone or email.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">Need help? We're here for you!</p>
          <button class="support-button">Contact Support</button>
        </div>
      </div>

      <!-- Additional Help -->
      <div class="additional-help">
        <p class="help-text">
          Didn't receive the code?
          <button class="resend-button" onclick="resendOTP()">Resend OTP</button>
        </p>
      </div>
    </div>

    <script>
      function copyOTP() { const otpCode =
      document.getElementById('otpCode').textContent; const copyButton =
      document.getElementById('copyButton'); const copyIcon =
      document.getElementById('copyIcon'); const copyText =
      document.getElementById('copyText');
      navigator.clipboard.writeText(otpCode).then(() => {
      copyButton.classList.add('copied'); copyIcon.className = 'fas fa-check';
      copyText.textContent = 'Copied!'; setTimeout(() => {
      copyButton.classList.remove('copied'); copyIcon.className = 'fas fa-copy';
      copyText.textContent = 'Copy'; }, 2000); }).catch(() => { // Fallback for
      older browsers const textArea = document.createElement('textarea');
      textArea.value = otpCode; document.body.appendChild(textArea);
      textArea.select(); document.execCommand('copy');
      document.body.removeChild(textArea); copyButton.classList.add('copied');
      copyIcon.className = 'fas fa-check'; copyText.textContent = 'Copied!';
      setTimeout(() => { copyButton.classList.remove('copied');
      copyIcon.className = 'fas fa-copy'; copyText.textContent = 'Copy'; },
      2000); }); } function resendOTP() { alert('OTP resent! Please check your
      email.'); }
    </script>
  </body>
</html>